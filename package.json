{
  "name": "@tanstack/svelte-start",
  "version": "0.0.3-experimental",
  "description": "Full-stack TanStack Start for Svelte — community port; mirrors @tanstack/vue-start.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y7ya-com/router.git",
    "directory": "packages/svelte-start"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/tannerlinsley"
  },
  "keywords": [
    "tanstack",
    "svelte",
    "start",
    "router",
    "ssr"
  ],
  "scripts": {},
  "type": "module",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "svelte": "./dist/client.js",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./client-rpc": {
      "types": "./dist/client-rpc.d.ts",
      "import": "./dist/client-rpc.js"
    },
    "./server-rpc": {
      "types": "./dist/server-rpc.d.ts",
      "import": "./dist/server-rpc.js"
    },
    "./ssr-rpc": {
      "types": "./dist/ssr-rpc.d.ts",
      "import": "./dist/ssr-rpc.js"
    },
    "./client-only": {
      "types": "./dist/client-only.d.ts",
      "import": "./dist/client-only.js"
    },
    "./server-only": {
      "types": "./dist/server-only.d.ts",
      "import": "./dist/server-only.js"
    },
    "./plugin/vite": {
      "types": "./dist/plugin/vite.d.ts",
      "import": "./dist/plugin/vite.js"
    },
    "./plugin/rsbuild": {
      "types": "./dist/plugin/rsbuild.d.ts",
      "import": "./dist/plugin/rsbuild.js"
    },
    "./package.json": "./package.json",
    "./server-entry": {
      "types": "./dist/default-entry/server.d.ts",
      "import": "./dist/default-entry/server.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=12"
  },
  "dependencies": {
    "@tanstack/start-client-core": "^1.170.14",
    "@tanstack/start-plugin-core": "^1.171.24",
    "@tanstack/start-server-core": "^1.169.17",
    "@tanstack/svelte-router": "github:y7ya-com/svelte-router#v0.0.3-experimental",
    "@tanstack/svelte-start-client": "github:y7ya-com/svelte-start-client#v0.0.3-experimental",
    "@tanstack/svelte-start-server": "github:y7ya-com/svelte-start-server#v0.0.3-experimental",
    "pathe": "^2.0.3",
    "@tanstack/router-core": "^1.171.15"
  },
  "peerDependencies": {
    "@rsbuild/core": "^2.0.0",
    "vite": ">=7.0.0",
    "svelte": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    }
  }
}
